{
  "name": "editpro",
  "productName": "EditPro",
  "description": "Professional photo and video editor for macOS, Windows, and Linux.",
  "author": {
    "name": "Jax Harlan",
    "url": "https://github.com/Unwrenchable"
  },
  "license": "MIT",
  "homepage": "https://github.com/Unwrenchable/EditPro",
  "repository": {
    "type": "git",
    "url": "https://github.com/Unwrenchable/EditPro.git"
  },
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "compile:electron": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "dev:electron": "npm run compile:electron && concurrently -k \"cross-env NODE_ENV=development vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron dist-electron/main.js\"",
    "build": "tsc -b && vite build",
    "build:web": "cross-env EDITPRO_TARGET=web npm run build",
    "build:mobile": "npm run build:web && cap sync",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg-core.mjs",
    "build:electron": "npm run build && npm run compile:electron",
    "dist": "npm run build:electron && electron-builder --publish never",
    "dist:mac": "npm run build:electron && electron-builder --mac --publish never",
    "dist:win": "npm run build:electron && electron-builder --win --publish never",
    "dist:linux": "npm run build:electron && electron-builder --linux --publish never",
    "generate:icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron-esm": "node scripts/check-electron-esm.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "build": {
    "appId": "com.editpro.app",
    "productName": "EditPro",
    "publish": {
      "provider": "github",
      "owner": "Unwrenchable",
      "repo": "EditPro"
    },
    "copyright": "Copyright © 2026 Jax Harlan",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/ffmpeg-static/**/*",
      "!dist-electron/*-unpacked/**",
      "!dist-electron/mac*/**",
      "!dist-electron/*.{AppImage,deb,exe,dmg,zip,blockmap,yml}",
      "!release/**"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/onnxruntime-web/dist/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/",
        "to": "ffmpeg-static",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build-resources/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icons",
      "category": "Graphics",
      "synopsis": "Photo and video editor",
      "maintainer": "Jax Harlan"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "menuCategory": "EditPro",
      "shortcutName": "EditPro",
      "uninstallDisplayName": "EditPro",
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "license": "LICENSE",
      "include": "build-resources/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "EditPro-Portable-${version}.exe"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-file-picker": "^8.1.1",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^3.7.6",
    "electron-updater": "^6.8.10",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-web": "^1.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.12",
    "wait-on": "^9.0.4"
  }
}
