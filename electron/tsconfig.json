{
  "compilerOptions": {
    "target": "ES2022",
    // Packaged main runs as Node ESM. NodeNext rejects extensionless relative
    // imports, which crash inside app.asar with ERR_MODULE_NOT_FOUND.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../dist-electron",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "preload.ts"]
}
